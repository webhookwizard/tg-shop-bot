# Copy to .env and fill in. Only BOT_TOKEN is required to go live.
# Everything else has sane defaults; the demo (python demo.py) needs none of this.

# Get from @BotFather on Telegram
BOT_TOKEN=

# Your Telegram user id(s), comma-separated. Admins approve payments, add products, top up credit.
# Find your id via @userinfobot
ADMIN_IDS=

# Shown to buyers
SHOP_NAME=My Corner Store

# USDT address buyers pay to (manual TXID path). TRC20 = ~$1 fees.
USDT_ADDRESS=
USDT_NETWORK=TRC20

# Optional: CryptoBot token for hosted auto-confirming invoices.
# Leave empty to use the manual TXID + admin-confirm path (zero API keys).
CRYPTOBOT_TOKEN=

# Buyer language: en | cn
DEFAULT_LANG=en

# SQLite file for the live bot (demo uses in-memory, nothing is written)
SHOP_DB=shop.db
